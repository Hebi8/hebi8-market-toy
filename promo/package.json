{
  "name": "hebi8-fx-replay-pv",
  "version": "1.0.0",
  "description": "Remotion project for the hebi8 FX replay Toy promo video",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.508",
    "@remotion/media": "4.0.508",
    "@remotion/transitions": "4.0.508",
    "@remotion/zod-types": "4.0.508",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.508",
    "uqr": "0.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.508",
    "@types/node": "26.2.0",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "capture": "node capture/capture.mjs",
    "studio": "remotion studio --no-open",
    "lint": "eslint src && tsc",
